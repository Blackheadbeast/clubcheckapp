{
  "name": "clubcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed": "npx tsx prisma/seed.ts",
    "video:studio": "npx remotion studio remotion/src/index.tsx",
    "video:short": "npx remotion render remotion/src/index.tsx ShortAd out/short-ad.mp4",
    "video:ad": "npx remotion render remotion/src/index.tsx SocialAd out/social-ad.mp4",
    "video:demo": "npx remotion render remotion/src/index.tsx SalesDemo out/sales-demo.mp4",
    "video:grinder": "npx remotion render remotion/src/index.tsx GrinderAd out/grinder-ad.mp4",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:dev": "prisma dev --detach --name clubcheck-dev"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "@remotion/cli": "^4.0.428",
    "@remotion/player": "^4.0.428",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^2.4.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.1.3",
    "lucide-react": "^0.469.0",
    "next": "^14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "remotion": "^4.0.428",
    "resend": "^6.7.0",
    "stripe": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.23",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "prisma": "^7.4.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
